# Capital.com DEMO credentials. Never commit the real values.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=

# Run `goldbot search Gold` to discover the demo account's Gold epic.
CAPITAL_EPIC=

# Explicit opt-in for protected orders on Capital.com's DEMO host only.
CAPITAL_DEMO_EXECUTION_ENABLED=false
CAPITAL_MAX_DEMO_SIZE=0.1
CAPITAL_RESOLUTION=MINUTE_5
CAPITAL_TREND_RESOLUTION=HOUR
CAPITAL_PRICE_COUNT=500

# Optional AI review. Leave OPENAI_API_KEY empty to use deterministic rules only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Telegram approval channel. Create the bot with @BotFather, send it /start,
# then run `goldbot telegram-discover` to find these two numeric IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_APPROVAL_TTL_SECONDS=600

# Risk settings used by local paper mode and demo execution.
PAPER_STARTING_BALANCE=10000
RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.01
MAX_TRADES_PER_DAY=15
MAX_SPREAD=0.80
POINT_VALUE_PER_UNIT=1.0

# Trade management. R is a position's initial risk (entry to original stop).
MAX_POSITIONS_PER_SESSION=3   # open positions per bot, all in one direction
MAX_OPEN_DEMO_POSITIONS=6     # safety cap per Capital.com account (all bots on it)
TRAIL_START_R=1.0             # at +1R the stop moves to breakeven, then trails
TRAIL_DISTANCE_R=1.0          # trailing stop distance behind price
TARGET_EXTEND_TRIGGER_R=0.25  # extend the target when price is this close to it
TARGET_EXTEND_R=1.0           # how far to push the target out
PYRAMID_AT_R=1.0              # add a position when the newest one is this far in profit

# New entries only during London open -> New York afternoon (DST aware), skipping the first
# minutes after the London open and after 08:30 ET. Use "all" to trade around the clock.
TRADING_HOURS=london-ny
OPEN_GUARD_MINUTES=15

# Optional second trend filter that must agree with the first (e.g. DAY for the 1h bot).
CAPITAL_CONFIRM_RESOLUTION=
